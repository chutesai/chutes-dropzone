#!/bin/sh
#
# s6 longrun: OpenWebUI
#
set -eu

if [ "${DROPZONE_ENABLE_OPENWEBUI:-true}" = "false" ]; then
    echo "openwebui: disabled (DROPZONE_ENABLE_OPENWEBUI=false)"
    exec sleep infinity
fi

DATA_DIR="${STANDALONE_OPENWEBUI_DATA_DIR:-/data/openwebui}"
APP_DATA_DIR="/app/backend/data"

mkdir -p "$DATA_DIR"
chown -R node:node "$DATA_DIR"

if [ -L "$APP_DATA_DIR" ]; then
    :
elif [ -d "$APP_DATA_DIR" ]; then
    if find "$APP_DATA_DIR" -mindepth 1 -maxdepth 1 >/dev/null 2>&1; then
        cp -a "$APP_DATA_DIR"/. "$DATA_DIR"/ 2>/dev/null || true
    fi
    rm -rf "$APP_DATA_DIR"
    ln -s "$DATA_DIR" "$APP_DATA_DIR"
else
    ln -s "$DATA_DIR" "$APP_DATA_DIR"
fi

# The bundled OpenWebUI image may ship a seeded SQLite database and related
# state files owned by root. After copying that data into the persistent
# directory, fix ownership and mode so the runtime node user can update config,
# create WAL/journal files, and write uploads on first boot.
chown -R node:node "$DATA_DIR"
chmod -R u+rwX "$DATA_DIR"

cd /app/backend
export HOME=/home/node
echo "openwebui: starting"
exec gosu node ./start.sh
