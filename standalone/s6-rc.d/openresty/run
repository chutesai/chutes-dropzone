#!/bin/sh
#
# s6 longrun: openresty
#
# Starts when:
#   INSTALL_MODE=local (edge proxy + e2ee Lua handlers)
#   INSTALL_MODE=domain AND ACME_EMAIL is empty (HTTP-only public edge)
#   INSTALL_MODE=domain AND CHUTES_TRAFFIC_MODE=e2ee-proxy AND ACME_EMAIL is set
#     (internal e2ee handler behind Caddy)
# Idles when:
#   INSTALL_MODE=domain AND CHUTES_TRAFFIC_MODE=direct AND ACME_EMAIL is set
#
set -eu

MODE="${STANDALONE_INSTALL_MODE:-local}"
TRAFFIC="${STANDALONE_TRAFFIC_MODE:-direct}"
ACME_EMAIL="${STANDALONE_ACME_EMAIL:-}"

if [ "$MODE" = "local" ]; then
    CONF="/tmp/nginx-standalone.conf"
elif [ "$MODE" = "domain" ] && [ -z "$ACME_EMAIL" ]; then
    CONF="/tmp/nginx-domain-http.conf"
elif [ "$MODE" = "domain" ] && [ "$TRAFFIC" = "e2ee-proxy" ]; then
    CONF="/tmp/nginx-e2ee-internal.conf"
else
    exec sleep infinity
fi

if [ ! -f "$CONF" ]; then
    echo "openresty: config not found at $CONF" >&2
    exit 1
fi

cp "$CONF" /usr/local/openresty/nginx/conf/nginx.conf

echo "openresty: starting (${MODE} + ${TRAFFIC})"
exec /usr/local/openresty/bin/openresty -g 'daemon off;'
