# Deployment mode
INSTALL_MODE="domain"
CHUTES_COMPOSE_FILES="docker-compose.yml:docker-compose.domain.yml"
EDGE_SERVICE="caddy"
CHUTES_TRAFFIC_MODE="direct"
DROPZONE_ENABLE_PUBLIC_LANDING="true"
# Set DROPZONE_ENABLE_OPENWEBUI="false" for n8n-only mode.
# Set DROPZONE_ENABLE_N8N="false" for chat-only mode.
# Leave both true to deploy both apps.
DROPZONE_ENABLE_OPENWEBUI="true"
DROPZONE_ENABLE_N8N="true"
E2EE_PROXY_IMAGE="parachutes/e2ee-proxy:latest@sha256:0af4965c84e3eace05063fe2a013e818c30dd3687e9690a3bea83ae1df3b9a56"
CADDY_IMAGE="caddy:2.11.2-alpine@sha256:a1b7e624f860619cea121bdbc5dec2e112401666298c6507c6793b0a3ee6fc8e"
# Used only when CHUTES_TRAFFIC_MODE="e2ee-proxy"
ALLOW_NON_CONFIDENTIAL="false"
# Leave this disabled so n8n SSO text traffic stays on the proxy path too.
CHUTES_SSO_PROXY_BYPASS="false"
CHUTES_PROXY_BASE_URL=""
# Internal service-to-service URL for the e2ee-proxy sidecar. deploy.sh sets
# this to http://e2ee-proxy:80 automatically in compose proxy mode; the
# dropzone image and audio bridges route through it instead of hitting
# chute subdomains directly.
CHUTES_PROXY_INTERNAL_URL=""
CHUTES_CREDENTIAL_TEST_BASE_URL=""

# Pinned app sources
N8N_VERSION="2.12.1"
N8N_SOURCE_REPO="https://github.com/n8n-io/n8n.git"
N8N_SOURCE_REF="n8n@2.12.1"
N8N_SOURCE_SHA="42c7f71b6863581044006af0309ac38aab8d7c9f"
OPENWEBUI_VERSION="v0.8.12"
OPENWEBUI_IMAGE="ghcr.io/open-webui/open-webui:v0.8.12@sha256:96737272eef841d3dd695d1bbe6e3db5262277609cbc807f9cdd62a6e7c5aa56"
SEARXNG_IMAGE="searxng/searxng:latest@sha256:c9100c29c14a77d5289263a671580226c3b8a396a1a0130d2f500f57076a0119"
# Advanced: reuse prebuilt local images instead of rebuilding app images during deploy.
# DROPZONE_N8N_IMAGE="chutes-dropzone-n8n:local"
# DROPZONE_OPENWEBUI_IMAGE="chutes-dropzone-openwebui:local"
# SKIP_APP_BUILDS="true"
TZ="UTC"

# Domain installs
DROPZONE_HOST="dropzone.example.com"
N8N_HOST="dropzone.example.com"
ACME_EMAIL="ops@example.com"

# Database (auto-generated by deploy.sh)
# POSTGRES_USER is the PostgreSQL superuser used for initial setup only.
# Each service gets its own credentials, restricted to its own database.
POSTGRES_USER="dropzone"
POSTGRES_PASSWORD=""
POSTGRES_N8N_DB="n8n"
POSTGRES_OPENWEBUI_DB="openwebui"
POSTGRES_DB="n8n"
POSTGRES_N8N_USER="dropzone_n8n"
POSTGRES_N8N_PASSWORD=""
POSTGRES_OPENWEBUI_USER="dropzone_owui"
POSTGRES_OPENWEBUI_PASSWORD=""

# n8n secrets (auto-generated by deploy.sh)
# CRITICAL: N8N_ENCRYPTION_KEY encrypts all stored n8n credentials at rest.
# Changing this key will permanently strand ALL existing encrypted credentials —
# they cannot be decrypted with a different key and must be re-created manually.
# Only rotate this key on a fresh install or after exporting all credentials.
N8N_ENCRYPTION_KEY=""
N8N_JWT_SECRET=""
N8N_RUNNERS_MODE="external"
N8N_RUNNERS_AUTH_TOKEN=""
N8N_ADMIN_EMAIL="svc-dropzone@internal.chutes.local"
N8N_ADMIN_PASSWORD=""
N8N_EXPIRABLE_CREDENTIAL_REFRESH_WINDOW_SECONDS="300"

# OpenWebUI runtime (auto-generated by deploy.sh)
WEBUI_SECRET_KEY=""
OPENWEBUI_NAME="Chutes Chat"
# Internal service account — password auth is disabled; this admin is only
# used by background sync scripts and is never exposed via the SSO login flow.
OPENWEBUI_ADMIN_NAME="Dropzone Service Account"
OPENWEBUI_ADMIN_EMAIL="svc-dropzone@internal.chutes.local"
OPENWEBUI_ADMIN_PASSWORD=""
OPENWEBUI_API_BASE_URL="https://llm.chutes.ai/v1"
OPENWEBUI_API_KEY=""
OPENWEBUI_MODELS_CACHE_TTL="300"
OPENWEBUI_MODEL_ORDER_SYNC_INTERVAL="300"
# Per-model defaults that the sync worker turns into native/agentic tools.
# Empty string disables default activation; comma-list supports web_search,image_generation.
OPENWEBUI_DEFAULT_FEATURE_IDS="web_search,image_generation"
# Open WebUI defaults to dark for first-time visitors. Users can still pick any
# theme from Settings -> General.
# Native web search in chat. Compose deployments use a private SearXNG sidecar
# with curated no-key engines, JSON output, and safe_web's SSRF-aware fetching.
# Set WEB_SEARCH_ENGINE="duckduckgo" to bypass SearXNG and use OpenWebUI's
# direct DuckDuckGo backend instead.
ENABLE_WEB_SEARCH="true"
WEB_SEARCH_ENGINE="searxng"
WEB_SEARCH_RESULT_COUNT="5"
WEB_SEARCH_CONCURRENT_REQUESTS="2"
SEARXNG_QUERY_URL="http://searxng:8080/search?q=<query>"
SEARXNG_SECRET=""
WEB_SEARCH_DOMAIN_FILTER_LIST="[]"
WEB_SEARCH_TRUST_ENV="false"
WEB_FETCH_MAX_CONTENT_LENGTH="50000"
WEB_LOADER_ENGINE="safe_web"
WEB_LOADER_CONCURRENT_REQUESTS="4"
WEB_LOADER_TIMEOUT="20"
ENABLE_WEB_LOADER_SSL_VERIFICATION="true"
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL="false"
BYPASS_WEB_SEARCH_WEB_LOADER="false"
DDGS_BACKEND="auto"
# Native image generation in chat. Chutes deployments discover live diffusion
# chutes and route directly to each chute's /generate endpoint in direct mode
# or through the local e2ee-proxy sidecar in proxy mode.
ENABLE_IMAGE_GENERATION="true"
ENABLE_IMAGE_PROMPT_GENERATION="true"
ENABLE_TITLE_GENERATION="true"
ENABLE_FOLLOW_UP_GENERATION="true"
IMAGE_GENERATION_ENGINE="openai"
IMAGE_GENERATION_MODEL="chutes-auto-image"
IMAGES_OPENAI_API_BASE_URL="https://llm.chutes.ai/v1"
IMAGES_OPENAI_API_KEY=""
IMAGES_OPENAI_API_PARAMS=""
DROPZONE_IMAGE_GENERATION_PROVIDER="chutes"
DROPZONE_IMAGE_FALLBACK_ATTEMPTS="8"
DROPZONE_IMAGE_FAILURE_COOLDOWN_SECONDS="90"
# Leave TASK_MODEL blank to let the currently selected chat model rewrite image
# requests and handle title/follow-up task generation. Set TASK_MODEL or
# TASK_MODEL_EXTERNAL only if you intentionally want a dedicated task model.
TASK_MODEL=""
TASK_MODEL_EXTERNAL=""
IMAGE_PROMPT_GENERATION_PROMPT_TEMPLATE="You turn recent chat context and the selected image model into one high-quality image request. A system note in the chat history may tell you which image model is selected and which parameters are already set. Infer the user's intended subject, setting, composition, lighting, perspective, medium, materials, color palette, mood, and any explicit constraints from the conversation. If the request is brief, add sensible visual detail without changing the core idea. Stay faithful to what the user wants, do not invent named entities or unsafe details they did not request. You may optionally suggest a negative prompt, image size, and step count when that would materially improve the result; otherwise omit them. Prefer conservative step counts for fast FLUX or schnell style models unless the user explicitly asks for a slower, higher-detail render. Output strict JSON only using the keys you are setting: {\"prompt\":\"...\",\"negative_prompt\":\"...\",\"size\":\"1024x1024\",\"steps\":6,\"rationale\":\"...\"}. Chat history: <chat_history>{{MESSAGES:END:8}}</chat_history>"
# STT modes: "local" (container-local faster-whisper), "openai" (Chutes Whisper
# bridge), or "web" (browser speech API). Render-safe default is local + base.
DROPZONE_AUDIO_TTS_MAX_CONCURRENCY="1"
DROPZONE_AUDIO_TTS_MIN_INTERVAL_SECONDS="2"
DROPZONE_AUDIO_TTS_RETRY_ATTEMPTS="8"
DROPZONE_AUDIO_TTS_RETRY_BASE_DELAY_SECONDS="2"
DROPZONE_AUDIO_STT_ENGINE="local"
DROPZONE_AUDIO_STT_LOCAL_MODEL="base"
# Internal-only auth for the OpenWebUI audio bridge. Auto-generated by deploy.sh.
DROPZONE_AUDIO_INTERNAL_API_KEY=""

# Chutes SSO
CHUTES_OAUTH_CLIENT_ID=""
CHUTES_OAUTH_CLIENT_SECRET=""
CHUTES_IDP_BASE_URL="https://api.chutes.ai"
CHUTES_AUTH_URL="https://chutes.ai/auth"
CHUTES_SSO_LOGIN_LABEL="Login with Chutes"
CHUTES_SSO_SCOPES="openid profile chutes:read chutes:invoke"
# Comma-separated Chutes usernames to promote to admin in both n8n and
# OpenWebUI when they log in via SSO.  Identity is verified against the
# IDP userinfo endpoint, not the user-editable display name.
# Example: CHUTES_ADMIN_USERNAMES="alice,bob,carol"
CHUTES_ADMIN_USERNAMES=""

# Optional deploy-time credential import for n8n/bootstrap only.
# This is not required by OpenWebUI.
CHUTES_API_KEY=""
